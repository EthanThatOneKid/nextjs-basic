' example/app/api/echo/route.bas
' POST example: accepts a message and count, returns the message repeated.
' ParseEchoRequest and WriteEchoResponse are generated by the plugin.

TYPE EchoRequest
    message AS STRING * 200
    count   AS INTEGER
END TYPE

TYPE EchoResponse
    result  AS STRING * 4000
    repeats AS INTEGER
END TYPE

FUNCTION POST (req AS Request, resp AS Response)
    DIM body AS EchoRequest
    DIM result AS EchoResponse

    ParseEchoRequest req, body

    DIM msg AS STRING
    DIM n AS INTEGER
    DIM i AS INTEGER
    DIM out AS STRING

    msg = RTRIM$(body.message)
    n = body.count

    ' Default to 1 repeat if count is 0 or negative
    IF n < 1 THEN n = 1
    ' Cap at 10 to stay within the fixed-length output buffer
    IF n > 10 THEN n = 10

    out = ""
    FOR i = 1 TO n
        IF i > 1 THEN out = out + " "
        out = out + msg
    NEXT i

    result.result  = out
    result.repeats = n

    WriteEchoResponse result, resp
    resp.statusCode = 200
END FUNCTION
